# Local development. Committed on purpose: these throwaway values only reach
# MySQL and Redis in docker-compose.dev.yml, which publish on 127.0.0.1 alone.
# Never reuse them anywhere else. To run without the debugger for one session:
#   FLASK_DEBUG=0 ./run_dev.sh

# Database
DB_HOST=localhost
DB_NAME=appdb_dev
DB_USER=app
DB_PASSWORD=devpass
DB_ROOT_PASSWORD=devrootpass

# Flask
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-not-for-production-0123456789

# Redis
REDIS_HOST=localhost
REDIS_USERNAME=app
REDIS_PASSWORD=devredispass
