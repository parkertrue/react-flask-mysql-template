# ============================================
# Development Environment (.env.dev)
# ============================================
# Copy these to .env.dev for local development

# Database configuration
MYSQL_HOST=localhost
MYSQL_DATABASE=appdb
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=password

# Redis configuration
REDIS_HOST=localhost
REDIS_DB=0
REDIS_PASSWORD=password


# ============================================
# Production Environment (.env.prod)
# ============================================
# Copy these to .env.prod for production deployment

# Database configuration
MYSQL_HOST=db
MYSQL_DATABASE=appdb
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password

# Flask configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=password

# Redis configuration
REDIS_HOST=redis
REDIS_DB=0
REDIS_PASSWORD=password