# ============================================
# Development Environment (.env.dev)
# ============================================
# Copy these to .env.dev for local development

# Database configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=appdb
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=password

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=password


# ============================================
# Integration Test Environment (.env.test)
# ============================================
# Copy these to .env.test for integration and E2E testing

# Database configuration
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=test_integration
MYSQL_USER=testuser
MYSQL_PASSWORD=testpass
MYSQL_ROOT_PASSWORD=testrootpass

# Flask configuration
FLASK_ENV=integration
SECRET_KEY=test-secret-key-for-ci-only
# E2E_MODE=true  # Uncomment when running Playwright E2E tests (enables JWT cookie security + CSRF)

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=testredispass


# ============================================
# Production Environment (.env.prod)
# ============================================
# Copy these to .env.prod for production deployment

# Database configuration
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=appdb
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password

# Flask configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=password

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=password