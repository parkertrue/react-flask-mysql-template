# Build context of nginx/Dockerfile, the repo root. It copies only frontend/
# and nginx's config, so only files generated inside frontend/ matter here.
# Unlike .gitignore, a pattern here matches only at the context root unless
# it starts with **/.

# Copied over the image's `npm ci`, it would ship the host's
# platform-specific binaries
frontend/node_modules/

# Build and test output
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
