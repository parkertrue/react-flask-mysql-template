# The repo root is the build context for nginx/Dockerfile only, which needs the
# frontend source and the nginx config. Allowlist rather than denylist, so env
# files, certs, venvs and anything added later stay out by default.
*
!frontend/
!nginx/*.conf
!nginx/templates/

# Host-built output inside frontend/. node_modules matters most: copying it
# over the image's `npm ci` would ship the host's platform-specific binaries.
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
