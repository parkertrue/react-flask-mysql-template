# Production: copy to .env.prod (gitignored) and replace every value.
# Hosts, ports and FLASK_ENV are fixed in docker-compose.yml; this file holds
# only what differs per deployment. ProductionConfig refuses a SECRET_KEY
# shorter than 32 characters. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Database
MYSQL_DATABASE=appdb
MYSQL_USER=your_db_user_here
MYSQL_PASSWORD=your_db_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# Redis
REDIS_PASSWORD=your_redis_password_here

# Flask
SECRET_KEY=your_secret_key_here
