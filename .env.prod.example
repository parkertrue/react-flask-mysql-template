# Production: copy to .env.prod
# Everything runs in docker-compose.yml, so hosts are Docker service names.
# Generate every secret below; ProductionConfig refuses a SECRET_KEY shorter
# than 32 characters. For example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# FLASK_DEBUG is intentionally absent: ProductionConfig forces it off.

# Database
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=appdb
MYSQL_USER=your_db_user_here
MYSQL_PASSWORD=your_db_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# Flask
FLASK_ENV=production
SECRET_KEY=your_secret_key_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here
