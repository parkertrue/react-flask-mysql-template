# Integration and E2E tests. Committed on purpose: these throwaway values live
# only as long as a test run. Ports match docker-compose.test.yml, whose E2E
# backend container sets its own hosts and ports for the Docker network.

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=appdb_test
MYSQL_USER=app
MYSQL_PASSWORD=testpass
MYSQL_ROOT_PASSWORD=testrootpass

# Flask
FLASK_ENV=integration
SECRET_KEY=test-secret-key-for-ci-only-0123456789

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=app
REDIS_PASSWORD=testredispass
