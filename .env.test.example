# Integration and E2E tests: copy to .env.test
# These throwaway values are safe to use as-is; the services live only as long
# as a test run. Ports match docker-compose.test.yml, which also points the E2E
# backend container at db/redis inside the Docker network.

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=test_integration
MYSQL_USER=testuser
MYSQL_PASSWORD=testpass
MYSQL_ROOT_PASSWORD=testrootpass

# Flask
FLASK_ENV=integration
SECRET_KEY=test-secret-key-for-ci-only

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=testredispass
