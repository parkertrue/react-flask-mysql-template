# Rendered into /etc/nginx/conf.d/ at container start; NGINX_SERVER_NAME
# comes from the environment (see nginx/Dockerfile and docker-compose.yml).

# Any other Host, including a bare IP, gets no response. Otherwise the
# client-controlled Host header would flow into redirects and request.host.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    # Redirect everything to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    # TLS certificate and key
    ssl_certificate      /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key  /etc/nginx/certs/privkey.pem;

    # Mozilla's "intermediate" TLS profile: forward-secret AEAD suites only.
    # Every one is strong, so the client may pick (it knows whether it has
    # AES hardware). TLS 1.3 suites are not set here; OpenSSL's are all fine.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:16m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    # Security limits. Every API body is a small JSON object; Flask's
    # MAX_CONTENT_LENGTH enforces the same cap.
    client_max_body_size 16k;
    client_body_buffer_size 16k;
    client_header_buffer_size 1k;
    # No longer than gunicorn's own limit on one header (8190 bytes), so a
    # header nginx accepts is never refused behind it. The app's own headers
    # (a JWT, its cookies) are well under 1 KB.
    large_client_header_buffers 4 8k;
    
    # Timeouts
    client_body_timeout 12;
    client_header_timeout 12;
    send_timeout 10;

    # Concurrent requests per client IP, applied only where they tie up one of
    # the backend's few request slots (the /api locations below). Over HTTP/2
    # every stream counts, so a server-wide limit would 429 the page's own
    # assets for users sharing an address; static files cost nginx nothing.
    limit_conn_status 429;

    # Vite's build output: every file name carries a hash of its content, so
    # a changed file gets a new URL and these can be cached for good. A prefix,
    # not an extension regex: a regex location would outrank /api below and
    # serve, say, /api/avatar.png from disk instead of proxying it.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security_headers.conf;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'" always;
        access_log off;
    }

    # Frontend - serve static files
    location / {
        try_files $uri $uri/ /index.html;

        # Revalidate HTML on every load: a cached index.html would point at
        # hashed bundles that the next deploy deleted.
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security_headers.conf;

        # Content Security Policy
        # script-src has no 'unsafe-inline': the Vite build emits external
        # hashed bundles. style-src keeps 'unsafe-inline' for React inline
        # style attributes.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;

        # Permissions Policy
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
    }

    # Auth endpoints - stricter rate limiting
    location ~ ^/api/auth/(login|register)$ {
        limit_req zone=auth burst=20 nodelay;
        limit_req_status 429;
        limit_conn addr 20;

        include /etc/nginx/security_headers.conf;
        # Nothing served here is a page; if one is opened directly (e.g. an
        # SVG or a JSON error), it may not run scripts or be framed.
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        
        proxy_pass http://backend;
        include /etc/nginx/proxy_params.conf;
    }

    # Health check - no rate limiting (exact match, must be above /api prefix block)
    location = /api/health {
        access_log off;

        include /etc/nginx/security_headers.conf;
        # Nothing served here is a page; if one is opened directly (e.g. an
        # SVG or a JSON error), it may not run scripts or be framed.
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

        proxy_pass http://backend;
        include /etc/nginx/proxy_params.conf;
    }

    # API endpoints - moderate rate limiting
    location /api {
        limit_req zone=api burst=20 nodelay;
        limit_req_status 429;
        limit_conn addr 20;

        include /etc/nginx/security_headers.conf;
        # Nothing served here is a page; if one is opened directly (e.g. an
        # SVG or a JSON error), it may not run scripts or be framed.
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        
        proxy_pass http://backend;
        include /etc/nginx/proxy_params.conf;
    }

    # Replace upstream 5xx bodies (including nginx's own 502/504 HTML when the
    # backend is down) with the API's JSON error shape. No "=" on error_page,
    # so the client still receives the original status code. 503 is left out:
    # nginx never sends one here (its limits answer 429), and the backend's
    # own 503 already carries a JSON message worth showing the user.
    proxy_intercept_errors on;

    error_page 500 502 504 /error.json;

    location = /error.json {
        internal;
        default_type application/json;
        include /etc/nginx/security_headers.conf;
        return 200 '{"error":{"code":"INTERNAL_ERROR","message":"Something went wrong"}}';
    }

    # limit_req and limit_conn rejections, in the same JSON shape as the
    # backend's own 429
    error_page 429 /rate_limited.json;

    location = /rate_limited.json {
        internal;
        default_type application/json;
        include /etc/nginx/security_headers.conf;
        return 200 '{"error":{"code":"RATE_LIMITED","message":"Too many requests, please try again later"}}';
    }

    error_page 413 /too_large.json;

    location = /too_large.json {
        internal;
        default_type application/json;
        include /etc/nginx/security_headers.conf;
        return 200 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"Request body too large"}}';
    }
}
